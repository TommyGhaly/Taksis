{
  "expo": {
    "name": "Ⲧⲁⲝⲓⲥ",
    "slug": "taksis",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/Splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-camera",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "usesAppleSignIn": true,
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "android16KbPageSize": true
          }
        }
      ],
      ["rn-mlkit-ocr", { "ocrModels": ["latin"], "ocrUseBundled": true }],
      [
        "expo-dev-client",
        { "developmentClient": true }
      ]
    ],
    "experimental": {
      "bridgeless": false
    },
    "extra": {
      "eas": {
        "projectId": "3b1e338f-eb92-4c7d-a84b-62060e5a6c9f"
      }
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.tghaly.taksis",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSCameraUsageDescription": "Allow Ⲧⲁⲝⲓⲥ to access your camera for taking photos for profile identification.",
        "NSPhotoLibraryUsageDescription": "Allow Ⲧⲁⲝⲓⲥ to access your photo library for uploading profile pictures."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "buildNumber": "1"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tghaly.taksis",
      "versionCode": 48,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {},
    "owner": "dgobran",
    "assetBundlePatterns": [
      "**/*",
      "assets/**/*",
      "screens/**/*",
      "components/**/*"
    ]
  }
}