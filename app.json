{
  "expo": {
    "name": "Ⲧⲁⲝⲓⲥ",
    "slug": "taksis",
    "scheme": "taksis",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/Splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Ⲧⲁⲝⲓⲥ uses the camera so you can take a profile photo for your member record, and scan a vehicle license plate to check a car in at church events.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "usesAppleSignIn": true,
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "android16KbPageSize": true
          }
        }
      ],
      "./plugins/withPodfilePatches",
      "./plugins/withFirebaseAppDelegate",
      "./plugins/withVehicleAppClip"
    ],
    "extra": {
      "eas": {
        "projectId": "3b1e338f-eb92-4c7d-a84b-62060e5a6c9f"
      }
    },
    "ios": {
      "scheme": "exp+taksis",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.tghaly.taksis",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Ⲧⲁⲝⲓⲥ uses Face ID to confirm it is you before opening the admin database tools, where member and family records can be edited.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Ⲧⲁⲝⲓⲥ accesses your photo library so you can pick an existing photo to use as the profile picture on your member record."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "10",
      "appleTeamId": "5ZRM8X66TN"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tghaly.taksis",
      "versionCode": 65,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.spsmwayland.org",
              "pathPrefix": "/c"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {},
    "owner": "dgobran",
    "assetBundlePatterns": [
      "**/*",
      "assets/**/*",
      "screens/**/*",
      "components/**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3b1e338f-eb92-4c7d-a84b-62060e5a6c9f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
