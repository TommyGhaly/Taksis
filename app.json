{
  "expo": {
    "name": "Ⲧⲁⲝⲓⲥ",
    "slug": "taksis",
    "scheme": "taksis",
    "version": "4.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/Splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-camera",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "usesAppleSignIn": true,
            "deploymentTarget": "16.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "android16KbPageSize": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3b1e338f-eb92-4c7d-a84b-62060e5a6c9f"
      }
    },
    "ios": {
      "scheme": "exp+taksis",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.tghaly.taksis",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Authenticate to access database administration.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Allow Ⲧⲁⲝⲓⲥ to access your camera for taking photos for profile identification.",
        "NSPhotoLibraryUsageDescription": "Allow Ⲧⲁⲝⲓⲥ to access your photo library for uploading profile pictures."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "1"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tghaly.taksis",
      "versionCode": 64,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "owner": "dgobran",
    "assetBundlePatterns": [
      "**/*",
      "assets/**/*",
      "screens/**/*",
      "components/**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3b1e338f-eb92-4c7d-a84b-62060e5a6c9f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
