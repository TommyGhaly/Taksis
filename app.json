{
  "expo": {
    "name": "Ⲧⲁⲝⲓⲥ",
    "slug": "taksis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "usesAppleSignIn": true
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "developmentClient": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3b1e338f-eb92-4c7d-a84b-62060e5a6c9f"
      }
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.tghaly.taksis",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.tghaly.taksis"
    },
    "owner": "dgobran"
  },
  "assetBundlePatterns": [
    "**/*",
    "assets/**/*",
    "screens/**/*",
    "components/**/*"
  ],
  "ios": {
    "supportsTablet": false,
    "bundleIdentifier": "com.tghaly.taksis",
    "usesAppleSignIn": true
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#000000"
    }
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "expo-location":
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for attendance.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location for attendance.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for attendance.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
}
